# Bloquear documentación interna y exigir sesión activa para las firmas digitales
<FilesMatch "\.(md|txt|json|bak|old)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^([a-z0-9_-]+\.png)$ ../api/firma.php?file=$1 [L,QSA]
</IfModule>
