Options -Indexes
DirectoryIndex index.html
AddType application/javascript .mjs .js

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /admin/
  RewriteRule ^manual(?:\.html)?$ api/manual-doc.php?view=page [L,QSA]
  RewriteRule ^signatures/([a-z0-9_-]+\.png)$ api/firma.php?file=$1 [L,QSA]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(inicio|fichas|historias|library|pacientes|consultorio|horarios|honorarios|clara|configuracion|interacciones|chats|mensajes|administracion|admin|sistema|ficha|comparar)(/.*)?$ index.html [L,QSA]

  # Fallback para cualquier subruta limpia de /admin/ que no sea archivo ni /api/ (evita 404 al refrescar)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/admin/api/
  RewriteRule ^.*$ index.html [L,QSA]
</IfModule>

<FilesMatch "^(config\.php|config\.example\.php|mail\.php|lib\.php|\.env.*|\.git.*)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<FilesMatch "\.(sql|bak|old|log|md|json|sha256|lock)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://api.frankfurter.app https://open.er-api.com https://dolarapi.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
  <FilesMatch "\.(html|js|mjs|css)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
